# Production relay environment.
# Keep Clerk secret values in the host/VPS secret store; do not commit them.
NODE_ENV=production
SYSTEM_COMMANDER_DEV_AUTH=false
CONVEX_DEPLOYMENT=prod:rugged-dolphin-510
CONVEX_URL=https://rugged-dolphin-510.convex.cloud
CONVEX_SITE_URL=https://rugged-dolphin-510.convex.site
SYSTEM_COMMANDER_PRODUCTION_CONVEX_URL=https://rugged-dolphin-510.convex.cloud
SYSTEM_COMMANDER_PUBLIC_URL=https://YOUR_PRODUCTION_RELAY_DOMAIN
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_ISSUER_URL=https://YOUR_PRODUCTION_CLERK_ISSUER
CLERK_AUTHORIZED_PARTIES=https://YOUR_PRODUCTION_RELAY_DOMAIN
SYSTEM_COMMANDER_REQUIRED_SCOPES=openid
TRUST_PROXY=true
PORT=3900
